{
  "name": "salesautocall-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-pdf-worker": "mkdir -p public && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "ensure-ffmpeg": "node node_modules/ffmpeg-static/install.js",
    "predev": "npm run copy-pdf-worker",
    "dev": "next dev",
    "prebuild": "npm run ensure-ffmpeg && npm run copy-pdf-worker",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:scan": "rm -rf .tmp-test && tsc --outDir .tmp-test --module commonjs --target es2022 --types node --esModuleInterop --skipLibCheck lib/tele/scanParser.ts lib/tele/scanParser.test.ts lib/tele/types.ts lib/tele/work.ts lib/tele/work.test.ts && node --test .tmp-test/scanParser.test.js .tmp-test/work.test.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "next": "^14.2.35",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3"
  }
}
