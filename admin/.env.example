# SalesAutoCall :: admin dashboard environment
# Copy to .env.local for local dev, or set in Vercel project settings.

# Public Supabase project (safe to expose — gated by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://rqgkzamuohdvttnkluzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_jbinu2H4JrpqAUp_3Prdpw_8pZzE58N

# Service-role secret — REQUIRED for super-admin actions that manage other users
# (create/reset/delete telecallers, delete a company). Never expose this to the
# browser; it is only read in server actions.
# Get it from: Supabase dashboard → Project Settings → API → "service_role" secret
# (or the newer sb_secret_... key). Add it in Vercel → Project → Settings →
# Environment Variables (Production + Preview), then redeploy.
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive OAuth (call-recording storage). Create an OAuth "Web application"
# client in Google Cloud, enable the Drive API, and add
#   {your-site}/api/gdrive/callback
# as an authorized redirect URI. Set the same two values in the Supabase Edge
# Function secrets (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET) as well.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
