# ---- General ----
.DS_Store
*.log
.env
.env.local
*.local

# ---- Node / Next.js (admin) ----
# Bare name, not node_modules/ — the trailing slash matches a DIRECTORY only,
# so a SYMLINK named node_modules slips straight past it. One did: a link into
# a scratchpad was committed, and Vercel's npm had to remove it mid-install.
node_modules
.next/
out/
dist/
admin/.vercel

# ---- Android / Gradle ----
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
*.iml
*.apk
*.aab
*.keystore
*.jks
android/keystore.properties
!debug.keystore

# ---- Misc ----
.idea/
.vscode/

# Next.js build info
*.tsbuildinfo
