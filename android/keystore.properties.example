# Copy to android/keystore.properties and fill in your real values.
# NEVER commit keystore.properties or the .jks file — they sign your app's identity.
#
# Create the keystore once (keep it forever; losing it means you can't update the app
# unless you use Play App Signing, which is recommended — see PLAY_STORE.md):
#
#   keytool -genkey -v -keystore salesautocall-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload

storeFile=salesautocall-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
