<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Place calls programmatically (auto-dialer) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Detect when a call starts / ends so we can dial the next contact -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Identify SIM slots on dual-SIM devices -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Foreground service that runs the auto-dial queue -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Required so the phoneCall foreground-service type is allowed on Android 14+ -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SalesAutoCallApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalesAutoCall"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SalesAutoCall.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".dialer.AutoDialerService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

    </application>
</manifest>
