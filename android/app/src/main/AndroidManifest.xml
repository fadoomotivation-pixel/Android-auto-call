<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app softphone (WebRTC) audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Attendance selfie capture (TakePicturePreview) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Place calls programmatically (auto-dialer) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Detect when a call starts / ends so we can dial the next contact -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Identify SIM slots on dual-SIM devices -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- Foreground service that runs the auto-dial queue -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Required so the call services may use the mic (record the SIM call) on Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Required so the phoneCall foreground-service type is allowed on Android 14+ -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Auto-answer the CallerDesk agent-leg call so the telecaller taps once, not twice -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ring a full-screen incoming-call screen even when the phone is locked -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Float the in-app call cockpit ABOVE the phone's own dialer (no default-dialer role needed) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Exact reminders for scheduled follow-up callbacks (degrades to inexact if denied) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Restart the SIP listener after a reboot so inbound cloud calls keep arriving -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- GPS-tagged attendance punch-in (selfie uses CAMERA perm above + location) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- In-app updater: download the new APK and launch the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".SalesAutoCallApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalesAutoCall"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SalesAutoCall.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the in-app updater hand the downloaded APK to the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".dialer.AutoDialerService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <service
            android:name=".dialer.ManualCallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <service
            android:name=".sip.SipBackgroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />

        <!-- Full-screen ringing screen for incoming SIP calls (shows over lock screen) -->
        <activity
            android:name=".ui.IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SalesAutoCall" />

        <service
            android:name=".sip.SalesConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <!-- Firebase Cloud Messaging: instant "new hot lead" pushes -->
        <service
            android:name=".fcm.SalesFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hot_leads" />

        <!-- Fires local notifications when a scheduled follow-up callback is due -->
        <receiver
            android:name=".notify.FollowUpAlarmReceiver"
            android:exported="false" />

        <!-- Re-registers SIP after a reboot / app update so inbound calls keep ringing -->
        <receiver
            android:name=".sip.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
